<!-- RemoteViews inflates framework ImageView; android:tint works on every supported API.
     AppCompat app:tint is not interpreted by the launcher host.
     Text autosizes within bounded rows: SP ceilings honor font scaling, while DP floors
     prevent a previously created payload from overflowing after host font-scale changes.
     The 8dp minimum also stays below 11sp at the system's Small (0.85) font setting.
     The two center lines have DP ceilings so their corners stay inside the smallest donut hole.
     Metric rows keep their natural group height when the launcher grows the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="6dp" android:background="@drawable/widget_background" android:baselineAligned="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/widget_configure" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_configure">
            <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:text="@string/widget_days_7" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_secondary" android:maxLines="2" />
        </FrameLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/widget_refresh_icon" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <FrameLayout android:id="@+id/widget_chart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageView android:id="@+id/widget_donut" android:src="@drawable/widget_donut_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_inner_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_inner" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_cover_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_cover" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_ratio" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/widget_preview_ratio" android:textSize="23sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10dp" android:autoSizeMaxTextSize="14dp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_text" android:maxLines="1" />
                <TextView android:id="@+id/widget_ratio_label" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/widget_inner" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10dp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_inner" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/widget_metrics" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="0dp" >
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_inner_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:includeFontPadding="false" android:text="@string/widget_inner" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_inner" android:maxLines="2" android:gravity="center_vertical" />
                <TextView android:id="@+id/widget_inner_time" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:includeFontPadding="false" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_text" android:maxLines="2" android:gravity="center_vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_cover_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:includeFontPadding="false" android:text="@string/widget_cover" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_cover" android:maxLines="2" android:gravity="center_vertical" />
                <TextView android:id="@+id/widget_cover_time" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:includeFontPadding="false" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_text" android:maxLines="2" android:gravity="center_vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_opens_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.2" android:gravity="center_vertical" android:includeFontPadding="false" android:text="@string/widget_opens" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_secondary" android:maxLines="2" />
                <TextView android:id="@+id/widget_open_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:includeFontPadding="false" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_text" android:maxLines="2" android:gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:visibility="gone" android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:includeFontPadding="false" android:text="@string/widget_no_data" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_secondary" android:maxLines="2" />
    <TextView android:id="@+id/widget_sync" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:includeFontPadding="false" android:text="@string/widget_never_synced" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="@color/widget_secondary" android:maxLines="2" />
</LinearLayout>
