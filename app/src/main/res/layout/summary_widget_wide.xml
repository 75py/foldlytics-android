<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_background"
    android:baselineAligned="false">

    <FrameLayout android:layout_width="match_parent" android:layout_height="28dp">
        <FrameLayout android:id="@+id/widget_configure" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_configure">
            <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="28dp" android:paddingEnd="28dp" android:text="@string/widget_days_7" android:textColor="@color/widget_secondary" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1dp" />
        </FrameLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="match_parent" android:layout_gravity="end" android:padding="5dp" android:src="@drawable/widget_refresh_icon" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_refresh" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/widget_chart" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2">
                <ImageView android:id="@+id/widget_donut" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_neutral" android:importantForAccessibility="no" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_inner_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_inner" android:importantForAccessibility="no" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_cover_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_cover" android:importantForAccessibility="no" tools:ignore="UseAppTint" />
                <LinearLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/widget_ratio" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_unavailable_value" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10dp" android:autoSizeMaxTextSize="14dp" android:autoSizeStepGranularity="1dp" />
                    <TextView android:id="@+id/widget_ratio_label" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_inner" android:textColor="@color/widget_inner" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1dp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/widget_metrics" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="2dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_inner_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_inner" android:textColor="@color/widget_inner" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" />
                    <TextView android:id="@+id/widget_inner_time" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_unavailable_value" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cover_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_cover" android:textColor="@color/widget_cover" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" />
                    <TextView android:id="@+id/widget_cover_time" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_unavailable_value" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_opens_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_opens" android:textColor="@color/widget_secondary" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" />
                    <TextView android:id="@+id/widget_open_count" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_unavailable_value" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="@string/widget_no_data" android:textColor="@color/widget_secondary" android:textSize="10sp" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_sync" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_never_updated" android:textColor="@color/widget_secondary" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1dp" />
</LinearLayout>
