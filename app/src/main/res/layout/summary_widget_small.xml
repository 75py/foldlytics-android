<!-- RemoteViews inflates framework ImageView; android:tint works on every supported API.
     AppCompat app:tint is not interpreted by the launcher host. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background" android:baselineAligned="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/widget_configure" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_configure">
            <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_days_7" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="2" />
        </FrameLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/widget_refresh_icon" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <FrameLayout android:id="@+id/widget_chart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageView android:id="@+id/widget_donut" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_neutral" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_inner_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_inner" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_cover_arc" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/widget_cover" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_ratio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_unavailable_value" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/widget_text" />
                <TextView android:id="@+id/widget_ratio_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_inner" android:textSize="11sp" android:textColor="@color/widget_inner" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/widget_metrics" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="0dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_inner_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_inner" android:textSize="11sp" android:textColor="@color/widget_inner" android:maxLines="2" />
                <TextView android:id="@+id/widget_inner_time" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_cover_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_cover" android:textSize="11sp" android:textColor="@color/widget_cover" android:maxLines="2" />
                <TextView android:id="@+id/widget_cover_time" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_opens_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_opens" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="2" />
                <TextView android:id="@+id/widget_open_count" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:text="@string/widget_unavailable_value" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_no_data" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="2" />
    <TextView android:id="@+id/widget_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_never_synced" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="2" />
</LinearLayout>
